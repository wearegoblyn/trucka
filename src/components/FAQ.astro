---
import { faqs } from "../data/content";
import FAQCard from "./FAQCard.astro";
import SectionBadge from "./SectionBadge.astro";
import SplitHeading from "./SplitHeading.astro";
---

<section id="faq" class="section-pad bg-velocity-wash" data-reveal-root>
  <div class="page-wrap flex flex-col items-start gap-8 lg:gap-12">
    <SectionBadge label="Concise Answers" />
    <div class="flex flex-col gap-6">
      <SplitHeading
        class="heading-section max-w-[600px]"
        text="Concise answers to the questions we hear most."
      />
      <p data-reveal data-reveal-delay="2" class="body-copy max-w-[900px]">
        We keep the process transparent so you can make an informed decision about whether a corporate acquisition is the right path for your business.
      </p>
    </div>
    <div
      class="-mx-5 w-[calc(100%+2.5rem)] lg:mx-0 lg:w-full"
      data-stagger-group
    >
      {faqs.map((faq, index) => (
        <FAQCard
          index={index}
          total={faqs.length}
          question={faq.question}
          answer={faq.answer}
        />
      ))}
    </div>
  </div>
</section>

<script>
  const bindFaqs = () => {
    document.querySelectorAll("[data-faq-item]").forEach((item) => {
      const trigger = item.querySelector("[data-faq-trigger]");
      if (!(trigger instanceof HTMLButtonElement) || trigger.dataset.bound === "true") return;
      trigger.dataset.bound = "true";
      trigger.addEventListener("click", () => {
        const open = item.classList.toggle("is-open");
        trigger.setAttribute("aria-expanded", String(open));
      });
    });
  };

  bindFaqs();
</script>
