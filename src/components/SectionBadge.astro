---
import badgeDot from "../assets/badge-dot.svg";

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div data-reveal data-reveal-delay="0" class="inline-flex items-center gap-2 rounded-lg border border-border-subtle bg-surface-card px-[18px] py-2.5 lg:gap-2 lg:px-3 lg:py-2">
  <img src={badgeDot.src} alt="" width="6" height="6" decoding="async" class="size-1.5 shrink-0 lg:size-2" />
  <span class="text-xs tracking-[0.96px] text-text-primary lg:text-sm lg:tracking-normal">
    {label}
  </span>
</div>
