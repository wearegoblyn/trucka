---
import SectionBadge from "./SectionBadge.astro";
---

<section id="approach" class="bg-velocity-wash section-pad-tall" data-reveal-root>
  <div class="page-wrap flex justify-center">
    <div class="flex max-w-[1040px] flex-col items-start gap-6 lg:items-center lg:gap-12">
      <SectionBadge label="The Velocity Difference" />
      <p data-reveal data-reveal-delay="1" class="heading-section lg:text-center">
        Velocity Strategic Inc. is an Orlando, Florida company that buys trucking corporations and LLCs outright.
        <span class="text-text-accent"> We pay cash</span>, use a written purchase agreement, and put the funds in escrow before the agreement is signed.
      </p>
    </div>
  </div>
</section>
