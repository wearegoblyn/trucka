---
interface Props {
  question: string;
  answer: string;
  index?: number;
  total?: number;
}

const { question, answer, index = 0, total = 1 } = Astro.props;
const panelId = `faq-panel-${index}`;
const steps = Math.max(total - 1, 1);
const mix = 78 - (index / steps) * 58;
---

<div
  class="faq-item w-full"
  data-faq-item
  style={`--i: ${index}; --faq-mix: ${mix}%;`}
>
  <button
    type="button"
    class="flex w-full cursor-pointer items-center justify-between gap-6 px-5 py-5 text-left text-white lg:px-0"
    data-faq-trigger
    aria-expanded="false"
    aria-controls={panelId}
  >
    <h3 class="font-serif text-xl font-normal leading-heading text-text-primary">{question}</h3>
    <span class="flex size-8 shrink-0 items-center justify-center text-white" aria-hidden="true">
      <svg
        class="faq-icon size-5"
        viewBox="0 0 20 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M5 7.5 10 12.5 15 7.5"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
  </button>
  <div id={panelId} class="faq-panel" role="region">
    <div class="faq-panel-inner">
      <p class="body-copy w-full px-5 pb-5 pr-16 lg:px-0 lg:pr-12">{answer}</p>
    </div>
  </div>
</div>

<style>
  .faq-item {
    background-color: color-mix(
      in srgb,
      var(--color-action-strong) var(--faq-mix),
      rgb(6 24 42)
    );
    transition: background-color var(--duration-fast) var(--ease-motion);
  }

  .faq-item:hover,
  .faq-item:focus-within {
    background-color: color-mix(
      in srgb,
      var(--color-action-strong) calc(var(--faq-mix) + 8%),
      rgb(6 24 42)
    );
  }

  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-panel) var(--ease-motion);
  }

  .faq-item.is-open .faq-panel {
    grid-template-rows: 1fr;
  }

  .faq-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq-icon {
    transition: transform var(--duration-panel) var(--ease-motion);
  }

  .faq-item.is-open .faq-icon {
    transform: rotate(180deg);
  }
</style>
