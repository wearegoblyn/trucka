---
import badgeDot from "../assets/badge-dot.svg";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  index?: number;
}

const { eyebrow, title, description, index = 0 } = Astro.props;
---

<article class="flex h-full flex-col items-start gap-5 rounded-2xl border border-border-subtle bg-surface-card p-8" style={`--i: ${index}`}>
  <div class="inline-flex items-center gap-2 rounded-[14px] border border-border-accent bg-white/8 px-4 py-2">
    <img src={badgeDot.src} alt="" width="6" height="6" decoding="async" class="size-1.5 shrink-0" />
    <span class="text-[11px] font-semibold uppercase tracking-[0.88px] text-text-primary">{eyebrow}</span>
  </div>
  <h3 class="font-serif text-2xl font-normal leading-none text-text-primary">{title}</h3>
  <p class="text-sm leading-[1.5] text-accent-soft">{description}</p>
</article>
