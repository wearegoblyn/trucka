---
interface Props {
  title: string;
  description: string;
  index?: number;
}

const { title, description, index = 0 } = Astro.props;
---

<article class="flex h-full flex-col items-start rounded-2xl border border-border-subtle bg-surface-card p-8" style={`--i: ${index}`}>
  <div class="mt-auto flex flex-col gap-5">
    <h3 class="font-serif text-2xl font-normal leading-heading text-text-primary">{title}</h3>
    <p class="text-base leading-body text-text-secondary">{description}</p>
  </div>
</article>
