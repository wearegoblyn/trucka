---
import { processSteps } from "../data/content";
import BaseCard from "./BaseCard.astro";
import SectionBadge from "./SectionBadge.astro";
import SplitHeading from "./SplitHeading.astro";
---

<section id="process" class="scroll-mt-24 py-16 lg:scroll-mt-28 lg:py-[120px]" data-reveal-root>
  <div class="page-wrap flex flex-col items-start gap-8 lg:gap-12">
    <SectionBadge label="The Acquisition Process" />
    <SplitHeading
      class="max-w-[600px] font-serif text-[32px] leading-[1.2] text-text-primary lg:text-5xl lg:leading-none lg:text-balance"
      text="A simple acquisition process built for clarity."
    />
    <p data-reveal data-reveal-delay="2" class="max-w-[900px] text-lg leading-[1.6] text-text-secondary">
      We keep the steps direct so you can understand what happens next. No vague promises, no hidden conditions, and no surprises after you've committed.
    </p>
    <div class="grid w-full gap-4 lg:grid-cols-3 lg:gap-10" data-stagger-group>
      {processSteps.map((step, index) => (
        <BaseCard index={index} eyebrow={step.eyebrow} title={step.title} description={step.description} />
      ))}
    </div>
  </div>
</section>
