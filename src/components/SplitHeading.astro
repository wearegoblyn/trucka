---
interface Props {
  as?: "h1" | "h2";
  text: string;
  class?: string;
  id?: string;
  delay?: "0" | "1" | "2";
}

const { as: Tag = "h2", text, class: className = "", id, delay = "1" } = Astro.props;
const lines = text.split("\n");
---

<Tag id={id} class:list={[className]} data-reveal data-reveal-delay={delay}>
  {lines.map((line, index) => (
    <>
      {index > 0 && (
        <>
          <span class="lg:hidden">{" "}</span>
          <br class="hidden lg:block" />
        </>
      )}
      {line}
    </>
  ))}
</Tag>
