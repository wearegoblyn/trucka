---
import { getImage } from "astro:assets";
import wholeCompanyDesktop from "../assets/whole-company-desktop.jpg";
import wholeCompanyMobile from "../assets/whole-company-mobile.jpg";
import SectionBadge from "./SectionBadge.astro";
import SplitHeading from "./SplitHeading.astro";

const quality = 55;

const desktopAvif = await getImage({
  src: wholeCompanyDesktop,
  format: "avif",
  width: 1920,
  widths: [960, 1440, 1920],
  quality,
});
const desktopWebp = await getImage({
  src: wholeCompanyDesktop,
  format: "webp",
  width: 1920,
  widths: [960, 1440, 1920],
  quality,
});
const mobileAvif = await getImage({
  src: wholeCompanyMobile,
  format: "avif",
  width: 780,
  widths: [390, 780],
  quality,
});
const mobileWebp = await getImage({
  src: wholeCompanyMobile,
  format: "webp",
  width: 780,
  widths: [390, 780],
  quality,
});
---

<section class="section-pad-tall relative isolate" data-reveal-root>
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <picture class="absolute inset-0 h-full w-full">
      <source
        media="(min-width: 64rem)"
        type="image/avif"
        srcset={desktopAvif.srcSet.attribute}
        sizes="100vw"
      />
      <source
        media="(min-width: 64rem)"
        type="image/webp"
        srcset={desktopWebp.srcSet.attribute}
        sizes="100vw"
      />
      <source type="image/avif" srcset={mobileAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={mobileWebp.srcSet.attribute} sizes="100vw" />
      <img
        src={mobileWebp.src}
        alt=""
        width={wholeCompanyMobile.width}
        height={wholeCompanyMobile.height}
        class="absolute inset-0 h-full w-full max-w-none object-cover opacity-35"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/0 to-black"></div>
  </div>
  <div class="page-wrap flex justify-center">
  <div class="flex max-w-[840px] flex-col items-center gap-6 text-center lg:gap-10">
    <SectionBadge label="Strategic Acquisition" />
    <SplitHeading
      class="heading-section max-w-[760px]"
      text="We buy the whole company, history and all."
    />
    <p data-reveal data-reveal-delay="2" class="text-xl leading-[1.6] text-accent-soft">
      The company's safety record, insurance history, and unpaid obligations stay with it. We review the file before making an offer and put every handover detail in writing-from corporate records to the business phone number. An honest price upfront, not surprises after you've committed.
    </p>
  </div>
  </div>
</section>
