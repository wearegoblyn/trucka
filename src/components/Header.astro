---
import { navLinks, site } from "../data/content";
import Button from "./Button.astro";
---

<header class="site-header sticky top-0 z-50 border-b border-white/10 py-4 shadow-[0_8px_9px_rgba(0,0,0,0.18)] backdrop-blur-xl backdrop-saturate-150 lg:py-6">
  <div class="page-wrap flex items-center justify-between">
  <a href="#top" class="shrink-0 font-brand text-2xl font-bold leading-none text-text-primary transition-opacity duration-200 ease-in-out hover:opacity-80 lg:text-[32px]">
    {site.shortName}
  </a>
  <nav class="hidden items-center gap-10 text-[15px] font-semibold text-text-primary lg:flex" aria-label="Primary">
    {navLinks.map((link) => (
      <a class="transition-colors duration-200 ease-in-out hover:text-text-accent" href={link.href}>{link.label}</a>
    ))}
  </nav>
  <div class="hidden lg:block">
    <Button href="#contact" label="Get Started" style="primary" />
  </div>
  <div class="lg:hidden">
    <Button href="#contact" label="Contact" style="outline" />
  </div>
  </div>
</header>
