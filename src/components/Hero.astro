---
import { getImage, Image } from "astro:assets";
import heroDesktop from "../assets/hero-desktop.jpg";
import heroMobile from "../assets/hero-mobile.jpg";
import Button from "./Button.astro";
import SectionBadge from "./SectionBadge.astro";
import SplitHeading from "./SplitHeading.astro";

const quality = 80;
const sizes = "100vw";

const desktopAvif = await getImage({
  src: heroDesktop,
  format: "avif",
  width: heroDesktop.width,
  widths: [768, heroDesktop.width],
  quality,
});
const desktopWebp = await getImage({
  src: heroDesktop,
  format: "webp",
  width: heroDesktop.width,
  widths: [768, heroDesktop.width],
  quality,
});
const mobileAvif = await getImage({
  src: heroMobile,
  format: "avif",
  width: heroMobile.width,
  widths: [390, heroMobile.width],
  quality,
});
---

<section
  class="relative isolate flex py-16 lg:-mt-[var(--header-height)] lg:pt-[calc(4rem+var(--header-height))] display:min-h-dvh display:flex-col display:justify-center display:py-24"
  aria-labelledby="hero-heading"
  data-reveal-root
  data-reveal-on="load"
>
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <picture class="absolute inset-0 h-full w-full">
      <source
        media="(min-width: 64rem)"
        type="image/avif"
        srcset={desktopAvif.srcSet.attribute}
        sizes={sizes}
      />
      <source
        media="(min-width: 64rem)"
        type="image/webp"
        srcset={desktopWebp.srcSet.attribute}
        sizes={sizes}
      />
      <source type="image/avif" srcset={mobileAvif.srcSet.attribute} sizes={sizes} />
      <Image
        src={heroMobile}
        alt=""
        format="webp"
        widths={[390, heroMobile.width]}
        sizes={sizes}
        quality={quality}
        class="h-full w-full max-w-none object-cover object-bottom opacity-70 xl:opacity-80"
        priority
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/45 to-black/85"></div>
  </div>

  <div class="page-wrap flex flex-col items-start gap-6 lg:items-center lg:gap-8 display:gap-12">
    <SectionBadge label="Direct Acquisition Advisory" loading="eager" />
    <SplitHeading
      as="h1"
      id="hero-heading"
      class="max-w-[1100px] font-serif text-[40px] leading-heading text-text-primary lg:text-center lg:text-5xl lg:text-balance display:text-[72px]"
      text={"We buy trucking companies\nthe way it's supposed to be\u00a0done."}
    />
    <p data-reveal data-reveal-delay="2" class="body-copy max-w-[720px] lg:text-center">
      Velocity Strategic Inc. is the premier corporate acquirer paying outright cash for trucking corporations and LLCs with complete security, legal purchase agreements, and verified third-party escrow.
    </p>
    <div data-reveal data-reveal-delay="3" class="cta-row">
      <Button href="#contact" label="Call Us Now" style="primary" full />
      <Button href="#contact" label="Email Us" style="secondary" full />
    </div>
  </div>
</section>
